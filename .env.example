# Copy to contracts/.env (contracts) / frontend/.env.local (frontend). Placeholders only — never commit real values.

# ── Contracts: RPC endpoints (used by foundry.toml [rpc_endpoints]) ──
ARBITRUM_SEPOLIA_RPC_URL=
ROBINHOOD_TESTNET_RPC_URL=
ROBINHOOD_CHAIN_ID=          # confirm before deploying there; Deploy.s.sol defaults to 46630

# ── Deploy.s.sol (all optional) ──
TIME_PROFILE=demo            # demo (1 minute = 1 month) | prod
USE_MOCK_USDG=false          # true → deploy MockUSDG with public mint
USDG_ADDRESS=                # override USDG token
STYLUS_CALCULATOR=           # deployed Stylus PremiumCalculator; empty → Solidity calculator
TREASURY_ADDRESS=
ARBITER_ADDRESS=
SEED_DEPOSIT=                # base units, default 1 USDG
YIELD_TIME_MULTIPLIER=       # simulated T-bill + GDN speed-up, default 43200 in demo
TBILL_YIELD_RESERVE=         # base units; default 1000 USDG with MockUSDG, 0 with real USDG
GDN_REWARDS_RESERVE=         # base units; default 1000 USDG with MockUSDG, 0 with real USDG

# ── Seed.s.sol (run by you; keys stay in your shell, never in git) ──
POOL_ADDRESS=
POLICY_MANAGER_ADDRESS=
CLAIM_MANAGER_ADDRESS=
INVESTOR_PRIVATE_KEY=
LANDLORD_PRIVATE_KEY=
TENANT_PRIVATE_KEY=
TENANT2_PRIVATE_KEY=
SEED_INVESTOR_DEPOSIT=
SEED_HAPPY_POLICY_ID=
SEED_DISPUTED_POLICY_ID=
SEED_DEFAULT_POLICY_ID=
SEED_ENDED_POLICY_ID=
SEED_DEFAULT_CLAIM_ID=

# ── Frontend (frontend/.env.local) ──
NEXT_PUBLIC_DATA_SOURCE=mock # mock | onchain
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_ROBINHOOD_TESTNET_CHAIN_ID=
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_TESTNET_EXPLORER_URL=
NEXT_PUBLIC_IPFS_GATEWAY=    # optional, default https://gateway.pinata.cloud/ipfs/
PINATA_JWT=                  # server-only; empty → /api/evidence returns mock CIDs
